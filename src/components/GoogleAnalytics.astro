---
// Google Analytics 4
---
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ME24SJN4RE"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-ME24SJN4RE', { send_page_view: false });

  // Send page_view on every navigation (initial + client-side View Transitions)
  document.addEventListener('astro:page-load', function() {
    gtag('event', 'page_view', {
      page_title: document.title,
      page_location: window.location.href,
    });
  });

  // Link clicks, delegated on document so it survives View Transitions.
  // link_location comes from the nearest [data-ga-location] ancestor (bio, footer, 404).
  document.addEventListener('click', function(e) {
    var link = e.target instanceof Element ? e.target.closest('a[href]') : null;
    if (!link) return;
    var section = link.closest('[data-ga-location]');
    var location = section ? section.getAttribute('data-ga-location') : 'other';
    var text = (link.getAttribute('aria-label') || link.textContent || '').trim().slice(0, 100);

    if (link.protocol === 'mailto:') {
      // Never send the address itself: GA4 forbids PII in event data
      gtag('event', 'contact_click', { method: 'email', link_text: text, link_location: location });
    } else if (link.hostname && link.hostname !== window.location.hostname) {
      gtag('event', 'outbound_link_click', {
        link_url: link.href,
        link_domain: link.hostname,
        link_text: text,
        link_location: location,
      });
    }
  });
</script>
