---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <section>
    <h1 class="mb-8 text-xl font-medium tracking-tight">Page not found</h1>

    <div class="prose prose-neutral dark:prose-invert">
      <p>
        This page doesn't exist anymore, or never did. Head back to the <a href="/" data-track="nav_link" data-track-surface="404" data-track-label="home">homepage</a>.
      </p>
    </div>
  </section>
</Base>
